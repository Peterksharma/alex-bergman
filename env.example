# Public site URL used for canonicals, sitemap, OG tags, and structured data
NEXT_PUBLIC_SITE_URL=https://arbergmandrafting.com
# Resend API Key
RESEND_API_KEY=******************
# Where the emails are sent to
CONTACT_EMAIL=******************
# From email address (must be verified in Resend) default is onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev
# Google Analytics 4 Measurement ID (Admin -> Data Streams -> Web). Omit to disable GA.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# --- Railway Postgres (project arbergman-drafting). Use the public TCP-proxy
# URL (postgres.railway.internal is only reachable inside Railway; Vercel is not).
DATABASE_URL=postgresql://postgres:********@xxxx.proxy.rlwy.net:12345/railway

# --- Railway bucket "arbergman-media" (S3-compatible). Values come from the
# bucket's Credentials tab / `railway bucket credentials --bucket arbergman-media`.
RAILWAY_BUCKET_ENDPOINT=https://t3.storageapi.dev
RAILWAY_BUCKET_NAME=arbergman-media-xxxxxxxx
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_ACCESS_KEY_ID=********
RAILWAY_BUCKET_SECRET_ACCESS_KEY=********
# Railway buckets are private (no public object URLs), so media is served by
# the /cdn/[...key] route and cached at Vercel's edge. Leave this unset unless
# you front the bucket with a public CDN host; then set it to that origin.
# NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Admin area (/admin). Generate the hash with:
#   node scripts/hash-password.mjs 'your password'
ADMIN_EMAIL=alex@example.com
ADMIN_PASSWORD_HASH=$2b$12$********
# 32+ random bytes for signing the session JWT: `openssl rand -base64 48`
AUTH_SECRET=********
