# Public site URL used for canonicals, sitemap, OG tags, and structured data
NEXT_PUBLIC_SITE_URL=https://arbergmandrafting.com
# Resend API Key
RESEND_API_KEY=******************
# Where the emails are sent to
CONTACT_EMAIL=******************
# From email address (must be verified in Resend) default is onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev
# Google Analytics 4 Measurement ID (Admin -> Data Streams -> Web). Omit to disable GA.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Cloudflare Turnstile (spam protection on the contact form).
# Create a widget at https://dash.cloudflare.com -> Turnstile -> Add widget
# (hostname: arbergmandrafting.com; widget mode: Managed). The values below
# are Cloudflare's documented test keys that always pass; replace both with
# the real pair before launch. Leave the secret unset to skip verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
